@model RewardsViewModel
@{ ViewData["Title"] = "Rewards"; }
<section class="page-heading"><div><span class="eyebrow">Rewards</span><h1>Something good is waiting</h1><p>Use your points for rewards and keep your vouchers ready for the counter.</p></div></section>
<div class="filter-row reward-tabs" role="tablist">
    <button class="filter-chip active" type="button" data-reward-tab="rewards">Rewards (@Model.Rewards.Count)</button>
    <button class="filter-chip" type="button" data-reward-tab="vouchers">Vouchers (@Model.Vouchers.Count)</button>
    <button class="filter-chip" type="button" data-reward-tab="mine">My items (@(Model.OwnedRewards.Count + Model.OwnedVouchers.Count))</button>
</div>
<div class="reward-panel" data-reward-panel="rewards">
<div class="reward-grid large">
    @foreach (var reward in Model.Rewards)
    {
        <article class="reward-card">
            <div class="d-flex justify-content-between"><span class="reward-category">@reward.Category</span>@if (reward.Owned) { <span class="owned-pill">Owned</span> }</div>
            <partial name="_RewardVisual" model="reward" /><h2>@reward.Name</h2><p>@reward.Description</p><div class="reward-footer"><strong>@(reward.Points > 0 ? $"{reward.Points:N0} points" : "Member benefit")</strong><a class="btn btn-sm btn-outline-dark" asp-action="RewardDetails" asp-route-id="@(reward.RewardId ?? reward.Id.ToString())">View details</a></div>
        </article>
    }
</div>
</div>
<div class="reward-panel d-none" data-reward-panel="vouchers">
<div class="reward-grid large">
    @foreach (var reward in Model.Vouchers)
    {
            <article class="reward-card"><span class="reward-category">@reward.Category</span><partial name="_RewardVisual" model="reward" /><h2>@reward.Name</h2><p>@reward.Description</p><div class="reward-footer"><strong>@(reward.DiscountAmount ?? $"{reward.Points} points")</strong><a class="btn btn-sm btn-outline-dark" asp-action="RewardDetails" asp-route-id="@(reward.RewardId ?? reward.Id.ToString())" asp-route-voucher="true">View details</a></div></article>
    }
</div>
</div>
<div class="reward-panel d-none" data-reward-panel="mine">
    @{ var owned = Model.OwnedRewards.Concat(Model.OwnedVouchers).ToArray(); }
    @if (owned.Length == 0) { <div class="empty-state panel">You do not have any rewards or vouchers yet.</div> }
    <div class="reward-grid large">
        @foreach (var reward in owned)
        {
            <article class="reward-card"><div class="d-flex justify-content-between"><span class="reward-category">@reward.Category</span><span class="owned-pill">@(Model.OwnedRewards.Contains(reward) ? "Claimed" : reward.CanRedeem ? "Owned" : "Expired or unavailable")</span></div><partial name="_RewardVisual" model="reward" /><h2>@reward.Name</h2><p>@reward.Description</p><div class="reward-footer"><strong>@(reward.ExpireAt?.ToString("dd MMM yyyy") ?? "Expiry not specified")</strong>@if (Model.OwnedVouchers.Contains(reward) && reward.CanRedeem) { <a class="btn btn-sm btn-outline-dark" asp-action="RewardDetails" asp-route-id="@reward.RewardId" asp-route-voucher="true">View details</a> }</div></article>
        }
    </div>
</div>
