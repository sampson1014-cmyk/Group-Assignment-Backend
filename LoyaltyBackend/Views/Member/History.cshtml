@model IReadOnlyList<ActivityRecord>
@{ ViewData["Title"] = "Activity history"; var selected = ViewData["Type"] as string; }
<section class="page-heading"><div><span class="eyebrow">Activity</span><h1>Your loyalty history</h1><p>Review wallet, points, stamps and redemption activity.</p></div></section>
<div class="filter-row">
    @foreach (var filter in new[] { "All", "Wallet", "Top-up", "Points", "Stamp", "Stamps used", "Reward", "Voucher", "Spending", "Voucher activity" })
    {
        var isActive = filter == "All" ? string.IsNullOrWhiteSpace(selected) : filter.Equals(selected, StringComparison.OrdinalIgnoreCase);
        <a class="filter-chip @(isActive ? "active" : "")" asp-action="History" asp-route-type="@(filter == "All" ? null : filter)">@filter</a>
    }
</div>
<div class="activity-list panel" id="history-records">
    @if (Model.Count == 0) { <div class="empty-state">No activity was found for this filter.</div> }
    @foreach (var item in Model)
    {
        <div class="activity-item"><span class="activity-badge" aria-hidden="true">@ActivityPresentation.Icon(item)</span><div><strong>@ActivityPresentation.Title(item)</strong><details class="activity-description"><summary>Transaction details</summary><p>@item.Description</p></details><small>@(item.OccurredAt == DateTime.MinValue ? item.Type : $"{item.OccurredAt:dd MMM yyyy, h:mm tt} · {item.Type}") · @(item.Status ?? "Recorded")</small>@if (item.Amount is not null && item.Points > 0) { <small>+@item.Points points earned</small> }@if (item.Type.Contains("top", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(item.ReferenceId)) { <a asp-action="TopUpDetails" asp-route-id="@item.ReferenceId">View details</a> }</div><div class="activity-value">@ActivityPresentation.Value(item)</div></div>
    }
</div>
@if (Model.Count < (int)(ViewData["Total"] ?? 0) && Model.Count < 10000)
{
    <div class="text-center mt-4"><a class="btn btn-outline-dark" asp-action="History" asp-route-type="@selected" asp-route-count="@(Model.Count + 8)" asp-fragment="history-records">Load more</a><p class="mt-2 text-muted">Showing @Model.Count of @ViewData["Total"] records</p></div>
}
