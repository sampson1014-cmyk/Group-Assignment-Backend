@model DashboardViewModel
@{
    ViewData["Title"] = "Member home";
    var tierName = string.IsNullOrWhiteSpace(Model.Member.Tier) ? "Member" : Model.Member.Tier.Trim();
    var tierLabel = tierName.EndsWith("member", StringComparison.OrdinalIgnoreCase)
        ? tierName
        : $"{tierName} member";
}

<section class="page-heading"><div><span class="eyebrow">Member home</span><h1>Hello, @Model.Member.Name.Split(' ')[0]</h1><p>Here is your loyalty snapshot today.</p></div><a class="btn btn-outline-dark" asp-action="Profile">Manage profile</a></section>

<section class="tier-hero" aria-label="Current membership tier">
    <div>
        <span class="eyebrow">Your current tier</span>
        <h2>You're a @tierLabel</h2>
        <p>Your wallet, points, stamps and claimed rewards are ready in one place.</p>
    </div>
    <a class="btn btn-light" asp-action="Wallet">Open my wallet</a>
</section>

@if (Model.Highlights.Count > 0)
{
    <section class="highlight-strip" aria-label="Member promotions">
        @foreach (var item in Model.Highlights)
        {
            <article><span class="eyebrow">@item.Subtitle</span><h2>@item.Title</h2><p>@item.Description</p>@if (!string.IsNullOrWhiteSpace(item.Link)) { <a class="btn btn-light" href="@item.Link" rel="noopener noreferrer">@(item.ButtonText ?? "Learn more")</a> }</article>
        }
    </section>
}

<section class="content-section">
    <div class="section-title"><div><span class="eyebrow">Discover</span><h2>Featured rewards</h2></div><a asp-action="Rewards">View all</a></div>
    <div class="reward-grid">
        @foreach (var reward in Model.FeaturedRewards)
        {
            <article class="reward-card"><span class="reward-category">@reward.Category</span><h3>@reward.Name</h3><p>@reward.Description</p><strong>@reward.Points points</strong></article>
        }
    </div>
</section>

<section class="content-section">
    <div class="section-title"><div><span class="eyebrow">Latest</span><h2>Recent activity</h2></div><a asp-action="History">Full history</a></div>
    <div class="activity-list">
        @if (Model.RecentActivity.Count == 0)
        {
            <div class="empty-state">No activity yet. Your counter transactions will appear here.</div>
        }
        @foreach (var item in Model.RecentActivity)
        {
            <div class="activity-item"><span class="activity-badge">@item.Type[0]</span><div><strong>@item.Description</strong><small>@item.OccurredAt.ToString("dd MMM yyyy, h:mm tt")</small></div><div class="activity-value">@(item.Amount is not null ? $"{item.Amount:+0.00;-0.00} RM" : item.Points is not null ? $"+{item.Points} pts" : "Added")</div></div>
        }
    </div>
</section>

<section class="feedback-cta" aria-labelledby="feedback-heading">
    <div class="feedback-cta-icon" aria-hidden="true">✦</div>
    <div>
        <span class="eyebrow">Your opinion matters</span>
        <h2 id="feedback-heading">How was your experience?</h2>
        <p>Tell us what worked well or what we can improve. You can also review feedback you submitted previously.</p>
    </div>
    <a class="btn btn-primary" asp-action="Feedback">Send feedback</a>
</section>
