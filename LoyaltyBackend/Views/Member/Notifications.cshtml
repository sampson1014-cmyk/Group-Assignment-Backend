@model IReadOnlyList<NotificationCard>
@{ ViewData["Title"] = "Notifications"; }
<section class="page-heading"><div><span class="eyebrow">Inbox</span><h1>Notifications</h1><p>Updates, announcements and member offers.</p></div>@if (Model.Any(x => x.IsUnread)) { <form asp-action="ReadAllNotifications" method="post"><button class="btn btn-outline-dark" type="submit">Mark all as read</button></form> }</section>
@if (Model.Count == 0) { <div class="empty-state panel">You do not have any notifications yet.</div> }
<div class="notification-list">
@foreach (var item in Model)
{
    <article class="notification-card @(item.IsUnread ? "unread" : "")"><span class="notification-dot"></span><div><div class="d-flex gap-2 align-items-center"><span class="reward-category">@item.Type</span><small>@(item.SentAt == DateTime.MinValue ? "" : item.SentAt.ToString("dd MMM yyyy, h:mm tt"))</small></div><h2><a asp-action="NotificationDetails" asp-route-id="@item.Id">@item.Title</a></h2><p>@item.Content</p></div>@if (item.IsUnread) { <form asp-action="ReadNotification" method="post"><input type="hidden" name="id" value="@item.Id"/><button class="btn btn-sm btn-outline-dark" type="submit">Mark as read</button></form> }</article>
}
</div>
