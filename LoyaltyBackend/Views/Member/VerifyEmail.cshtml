@model OtpChallengeViewModel
@{ ViewData["Title"] = "Verify email"; }
<section class="auth-shell"><div class="auth-copy"><span class="eyebrow">Account security</span><h1>Verify your email.</h1><p>Request a code for the email associated with your member account, then enter it here.</p></div><div class="form-card"><h2>Email verification</h2>@if (ViewData["VerificationRequested"] as bool? != true) { <form asp-action="RequestEmailVerification" method="post"><input asp-for="PhoneNumber" type="hidden"/><button class="btn btn-primary w-100 btn-lg" type="submit">Send verification email</button></form> } else { <form asp-action="VerifyEmail" method="post"><input asp-for="PhoneNumber" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div>@if (ViewData["OtpHint"] is string otpHint && !string.IsNullOrWhiteSpace(otpHint)) { <div class="alert alert-info">Development verification code: <strong>@otpHint</strong></div> }<div class="form-floating mb-4"><input asp-for="Otp" class="form-control otp-input" placeholder="Code" autocomplete="one-time-code" inputmode="numeric" maxlength="6"/><label asp-for="Otp"></label><span asp-validation-for="Otp" class="text-danger"></span></div><button class="btn btn-primary w-100 btn-lg" type="submit">Verify email</button></form> }</div></section>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
