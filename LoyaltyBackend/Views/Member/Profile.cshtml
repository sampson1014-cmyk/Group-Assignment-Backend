@model MemberSummary
@{ ViewData["Title"] = "Profile"; }
<section class="page-heading"><div><span class="eyebrow">Account</span><h1>Your profile</h1><p>Manage your member information and account preferences.</p></div></section>
<div class="profile-grid">
    <section class="form-card"><h2>Member details</h2><div class="profile-avatar">@if (!string.IsNullOrWhiteSpace(Model.PhotoSource)) { <img src="@Model.PhotoSource" alt="@Model.Name profile photo"/> } else { @string.Concat(Model.Name.Split(' ').Take(2).Select(x => x[0])) }</div><dl class="profile-details"><div><dt>Name</dt><dd>@Model.Name</dd></div><div><dt>Member ID</dt><dd>@Model.MemberCode</dd></div><div><dt>Tier</dt><dd>@Model.Tier</dd></div><div><dt>Referral code</dt><dd><strong>@Model.ReferralCode</strong></dd></div></dl><a class="btn btn-outline-dark" asp-action="EditProfile">Edit profile</a></section>
    <section class="settings-list"><a class="settings-link" asp-action="Notifications"><article><div><h2>Notifications</h2><p>View announcements and mark them as read.</p></div><span>Open →</span></article></a><a class="settings-link" asp-action="Referrals"><article><div><h2>Referrals</h2><p>Share your code and see friends who joined.</p></div><span>Open →</span></article></a><a class="settings-link" asp-action="VerifyEmail"><article><div><h2>Verify email</h2><p>Request a verification code for your registered email.</p></div><span>Verify →</span></article></a><a class="settings-link" asp-action="Feedback"><article><div><h2>Feedback</h2><p>Send feedback and review previous submissions.</p></div><span>Open →</span></article></a><article class="danger-setting"><div><h2>Deactivate account</h2><p>Deactivating your account disables access but does not permanently delete your data.</p></div><form asp-action="DeleteAccount" method="post" data-confirm-title="Deactivate your account?" data-confirm-message="Your account access will be disabled and you will be logged out. Your data will not be permanently deleted." data-confirm-button="Deactivate account" onsubmit="return window.EduvoFeedback ? true : confirm('Deactivate this member account? You will be logged out.');"><input type="hidden" name="confirm" value="true"/><button class="btn btn-sm btn-outline-danger" type="submit">Deactivate</button></form></article></section>
</div>
