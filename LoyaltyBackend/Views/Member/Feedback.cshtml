@model FeedbackPageViewModel
@{ ViewData["Title"] = "Feedback"; }
<section class="page-heading"><div><span class="eyebrow">Help us improve</span><h1>Send feedback</h1><p>Tell us about your experience with the loyalty programme.</p></div></section>
<div class="form-card narrow-card"><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="form-floating mb-3"><input asp-for="Form.Title" class="form-control" placeholder="Title"/><label asp-for="Form.Title"></label><span asp-validation-for="Form.Title" class="text-danger"></span></div><div class="form-floating mb-3"><select asp-for="Form.Category" class="form-select"><option>General</option><option>Rewards</option><option>Wallet</option><option>Store experience</option><option>Technical issue</option></select><label asp-for="Form.Category"></label><span asp-validation-for="Form.Category" class="text-danger"></span></div><div class="form-floating mb-3"><select asp-for="Form.Rating" class="form-select"><option value="5">5 - Excellent</option><option value="4">4 - Good</option><option value="3">3 - Average</option><option value="2">2 - Poor</option><option value="1">1 - Very poor</option></select><label asp-for="Form.Rating"></label><span asp-validation-for="Form.Rating" class="text-danger"></span></div><div class="form-floating mb-3"><textarea asp-for="Form.Description" class="form-control tall-input" placeholder="Description"></textarea><label asp-for="Form.Description"></label><span asp-validation-for="Form.Description" class="text-danger"></span></div><div class="form-floating mb-4"><input asp-for="Form.Location" class="form-control" placeholder="Location"/><label asp-for="Form.Location"></label><span asp-validation-for="Form.Location" class="text-danger"></span></div><button class="btn btn-primary" type="submit">Submit feedback</button></form></div>
<section class="content-section"><div class="section-title"><h2>Previous feedback</h2><span>@Model.History.Count submitted</span></div>@if (Model.History.Count == 0) { <div class="empty-state panel">You have not submitted feedback yet.</div> }<div class="activity-list">@foreach (var item in Model.History) { <div class="activity-item"><span class="activity-badge">@item.Rating</span><div><strong>@item.Title</strong><small>@item.Category · @item.Description</small></div><div>@(item.CreatedAt?.ToString("dd MMM yyyy") ?? "Submitted")</div></div> }</div></section>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
