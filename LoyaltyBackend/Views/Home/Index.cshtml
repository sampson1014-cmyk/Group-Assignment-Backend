@{
    ViewData["Title"] = "Your rewards, all in one place";
}

<section class="hero">
    <div class="hero-copy">
        <span class="eyebrow">Every visit counts</span>
        <h1>Earn more from the places you already love.</h1>
        <p>Keep your wallet, points, stamps and rewards together. Show one member QR at the counter and watch your benefits grow.</p>
        <div class="d-flex flex-wrap gap-3">
            <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register">Create an account</a>
            <a class="btn btn-outline-dark btn-lg" asp-controller="Account" asp-action="Login">Member login</a>
        </div>
    </div>
    <div class="hero-card">
        <div class="member-card-preview">
            <div class="d-flex justify-content-between"><strong>EDUVO</strong><span>MEMBER</span></div>
            <div class="preview-balance"><small>Your benefits</small><strong>One member card</strong></div>
            <div class="d-flex justify-content-between"><span>Wallet &amp; points</span><span>Rewards &amp; stamps</span></div>
        </div>
        <div class="mini-stat"><strong>One QR</strong><span>Earn, pay and redeem at the counter.</span></div>
    </div>
</section>

<section class="feature-grid">
    <article><span class="feature-icon">✦</span><h2>Earn automatically</h2><p>Track points and stamps after every eligible counter purchase.</p></article>
    <article><span class="feature-icon">◈</span><h2>Rewards ready</h2><p>Browse member rewards and keep your vouchers close at hand.</p></article>
    <article><span class="feature-icon">◎</span><h2>See every activity</h2><p>Review top-ups, spending, points, stamps and redemptions.</p></article>
</section>
