<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Eduvo Rewards</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LoyaltyBackend.styles.css" asp-append-version="true" />
</head>
<body class="app-body">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
            <div class="container">
                <a class="navbar-brand brand-mark" asp-controller="Home" asp-action="Index"><span>E</span> Eduvo Rewards</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item"><a class="nav-link" asp-controller="Member" asp-action="Dashboard">Home</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Member" asp-action="Wallet">Wallet</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Member" asp-action="History">History</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Member" asp-action="Outlets">Stores</a></li>
                        </ul>
                        <div class="d-flex align-items-center gap-3">
                            <a class="nav-link text-white" asp-controller="Member" asp-action="Notifications" aria-label="Notifications">Inbox</a>
                            <a class="nav-link text-white" asp-controller="Member" asp-action="Profile">@User.Identity.Name</a>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button class="btn btn-outline-light btn-sm" type="submit">Log out</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="ms-auto d-flex gap-2">
                            <a class="btn btn-link text-white" asp-controller="Account" asp-action="Login">Log in</a>
                            <a class="btn btn-light" asp-controller="Account" asp-action="Register">Join now</a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container page-shell">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container">
            <span>&copy; 2026 Eduvo Rewards</span>
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
