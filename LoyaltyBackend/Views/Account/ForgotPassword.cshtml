@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot password"; }
<section class="auth-shell"><div class="auth-copy"><span class="eyebrow">Account recovery</span><h1>Reset your password.</h1><p>We will send a verification code to your registered phone number.</p></div><div class="form-card"><h2>Find your account</h2><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="form-floating mb-4"><input asp-for="PhoneNumber" class="form-control" placeholder="Phone" autocomplete="tel"/><label asp-for="PhoneNumber"></label><span asp-validation-for="PhoneNumber" class="text-danger"></span></div><button class="btn btn-primary w-100 btn-lg" type="submit">Send reset code</button></form><p class="form-foot"><a asp-action="Login">Back to login</a></p></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
